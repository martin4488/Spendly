# Copiar a .env.local (git lo ignora).
#
# Los dos primeros los saca de Supabase → Project Settings → API.
# Son los únicos que necesita la app para correr.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Solo para el smoke test contra Supabase real (tests/supabase-live.test.mjs) ──
# Sin esto, `npm test` corre igual: el test en vivo se saltea solo y el de
# contrato (que no necesita red) sigue cubriendo el cliente.
#
# Usá una cuenta de prueba, no la tuya de todos los días.
SPENDLY_TEST_EMAIL=
SPENDLY_TEST_PASSWORD=

# El test en vivo es de solo lectura salvo que pongas esto en 1, y en ese caso
# inserta un gasto de 0,01 marcado como [spendly-test] y lo borra al terminar.
SPENDLY_TEST_ALLOW_WRITES=0
